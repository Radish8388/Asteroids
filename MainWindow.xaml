<Window x:Class="Asteroids.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Asteroids"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_KeyDown"
        SizeChanged="Window_SizeChanged"
        Title="Asteroids"
        MinWidth="400" MinHeight="400"
        Height="650" Width="600">

    <Window.Resources>
        <Style x:Key="RoundedButton3" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top"  Orientation="Horizontal" HorizontalAlignment="Center" Height="30">
            <TextBlock x:Name="Lives" Text="Lives : 5" FontSize="24" Margin="0,0,30,0"/>
            <TextBlock x:Name="Level" Text="Level : 1" FontSize="24" Margin="0,0,30,0"/>
            <TextBlock x:Name="Score" Text="Score : 0" FontSize="24" Margin="0,0,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom"  Orientation="Horizontal" HorizontalAlignment="Center" Height="36">
            <Button Content="New Game" Width="75" Margin="0,0,10,0" Click="NewGameButton_Click" Style="{StaticResource RoundedButton3}"/>
            <Button x:Name="PauseButton" Content="Pause" Width="60" Margin="0,0,10,0" Click="PauseButton_Click" Style="{StaticResource RoundedButton3}"/>
            <Button Content="Options" Width="60" Margin="0,0,10,0" Click="OptionsButton_Click" Style="{StaticResource RoundedButton3}"/>
            <Button Content="Help" Width="60" Margin="0,0,10,0" Click="HelpButton_Click" Style="{StaticResource RoundedButton3}"/>
            <Button Content="Scores" Width="60" Margin="0,0,10,0" Click="ScoresButton_Click" Style="{StaticResource RoundedButton3}"/>
        </StackPanel>

        <Grid Margin="5">
            <Canvas x:Name="canvas" Background="Black" SizeChanged="canvas_SizeChanged" ClipToBounds="True"/>
        </Grid>
    </DockPanel>
</Window>
